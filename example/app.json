{
  "expo": {
    "name": "expo-speech-recognizer-example",
    "slug": "expo-speech-recognizer-example",
    "version": "0.1.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marianif.expospeechexample"
    },
    "android": {
      "package": "com.marianif.expospeechexample"
    },
    "plugins": [
      [
        "../app.plugin",
        {
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to use speech recognition.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access the microphone for speech recognition."
        }
      ]
    ]
  }
}
