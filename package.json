{
  "name": "expo-speech-recognizer",
  "version": "0.1.0",
  "description": "Real-time speech recognition for Expo apps (iOS + Android), with offline file transcription on iOS.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "expo-module test",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "ts:check": "tsc -p . --noEmit",
    "open:ios": "open -a \"Xcode\" example/ios",
    "open:android": "open -a \"Android Studio\" example/android"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-modules",
    "speech-recognition",
    "speech-to-text",
    "transcription",
    "SpeechRecognizer",
    "SFSpeechRecognizer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marianif/speech-recognizer.git"
  },
  "bugs": {
    "url": "https://github.com/marianif/speech-recognizer/issues"
  },
  "author": "Federica Mariani <marianif.jobs@gmail.com> (https://github.com/marianif)",
  "license": "MIT",
  "homepage": "https://github.com/marianif/speech-recognizer#readme",
  "dependencies": {},
  "devDependencies": {
    "@types/react": "~19.2.10",
    "expo": "~57.0.27",
    "expo-module-scripts": "^56.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
